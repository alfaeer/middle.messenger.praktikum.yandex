{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "npm install && npm run build && npm run preview",
    "install-dependencies": "npm install",
    "tslint": "tsc --noEmit",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "stylelint": "stylelint \"**/*.css\"",
    "stylelint-fix": "stylelint \"**/*.css\" --fix",
    "lint-validation": "npm run tslint && npm run eslint && npm run stylelint && npm test",
    "prepare": "husky",
    "test": "jest"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1",
    "handlebars": "^4.7.8",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "@types/jest": "^30.0.0",
    "ts-jest": "^29.4.6",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-tailwindcss": "^1.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
