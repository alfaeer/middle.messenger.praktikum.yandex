{{#> FormContainer title="Авторизация"}}
    <form id="sign-in-form" method="post" class="sign-in-form">
        {{> Input id="login" label="Логин" }}
        {{> Input id="password" label="Пароль" }}
        {{> Button id="submit" label="Авторизоваться" type="primary" }}
        {{> Button id="sign-up" label="Нет аккаунта?" type="link" }}
    </form>
{{/ FormContainer}}
