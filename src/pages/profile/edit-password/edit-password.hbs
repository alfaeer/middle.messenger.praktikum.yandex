{{#> ProfileContainer title="Edit Пароль"}}
    <div class="header-container">
        <div class="main-img-container">
            <a id="" href="#">
                <div class="profile-hover-text">Поменять аватар</div>
            </a>
        </div>
        <div class="profile-name">
            Иван
        </div>
    </div>
    <main class="main-container">
        <form id="edit-profile-form" method="post">
            <table class="view-table edit-profile">
                <tr class="info-row">
                    <th>Старый пароль</th>
                    <td>
                        <input type="text" id="old-password" name="oldPassword">
                    </td>
                </tr>
                <tr class="info-row">
                    <th>Новый пароль</th>
                    <td>
                        <input type="text" id="new-password" name="newPassword">
                    </td>
                </tr>
                <tr class="info-row">
                    <th>Повторите новый пароль</th>
                    <td>
                        <input type="text" id="new-password-confirm" name="newPasswordConfirm">
                    </td>
                </tr>
            </table>
            <div class="buttons-container">
                {{> Button id="profile-edit-save" label="Сохранить" type="primary" }}
            </div>
        </form>
    </main>
{{/ProfileContainer}}
