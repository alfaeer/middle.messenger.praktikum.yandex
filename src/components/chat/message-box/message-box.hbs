<div class="message-box-container" data-id="{{id}}">
    <div class="message-profile">
        <div class="message-profile-info">
            {{> Avatar url=avatar width="56px" height="56px" }}
            <div class="profile">
                <h3>{{profileName}}</h3>
            </div>
            <div class="actions">
                {{> Button id="message-actions" type="link button-actions" label="..." }}
            </div>
        </div>
    </div>
    <div class="messages-container">
        <div class="message-list">
            {{#if messages}}
                {{#each messages}}
                    {{> MessageField}}
                {{/each}}
            {{else}}
                <div class="message-no-messages">
                    <p>У вас еще нет сообщений с этим пользователем</p>
                </div>
            {{/if}}
        </div>
    </div>
    <div class="message-input-container">
        {{> Editor }}
    </div>
</div>
